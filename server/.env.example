# Copy this file to .env and fill in your own values

# MongoDB Atlas connection string (the database name at the end is "capstone")
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/capstone?retryWrites=true&w=majority&appName=Cluster0

# Secret used to sign JSON Web Tokens - use a long random string
JWT_SECRET=replace-with-a-long-random-string

# Port the API listens on
PORT=5000

# Browser origin allowed to call the API (comma separated for more than one).
# Local: http://localhost:5173 - deployed: the Render/Vercel site URL
CLIENT_URL=http://localhost:5173

# Leave unset (or 1) when a hosting proxy sits in front of the API, so req.ip
# is the real visitor and the rate limits count the right client.
# Set 0 only when the API is reached directly with no proxy.
TRUST_PROXY=1
