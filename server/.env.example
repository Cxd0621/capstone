# Copy this file to .env and fill in your own values

# MongoDB Atlas connection string (the database name at the end is "capstone")
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/capstone?retryWrites=true&w=majority&appName=Cluster0

# Secret used to sign JSON Web Tokens - use a long random string
JWT_SECRET=replace-with-a-long-random-string

# Port the API listens on
PORT=5000
